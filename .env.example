# Server Configuration
PORT=8000

# MongoDB Configuration
# Direct MongoDB Connection URI (used if provided)
MONGODB_URI=mongodb://127.0.0.1:27017/tutor_book

# Alternative Atlas Configuration (used if MONGODB_URI is not set)
DBUSERNAME=
DBPASSWORD=
DBNAME=tutor_book
DBLINK=cluster0.example.mongodb.net

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

